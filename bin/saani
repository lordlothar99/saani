#!/usr/bin/env bash
# The saani command for Claude Code: the plugin's bin/ is on the PATH of Claude's shell while the plugin is enabled, and the guard hook
# runs through it before every tool call, so it starts one Python only: `py -3`, else `python`, else `python3`, skipping the Windows
# Store stubs (WindowsApps). saani.py itself refuses a Python older than 3.11.
src="${BASH_SOURCE[0]}"                   # no subshell, no dirname process: the hook pays for every one
case "$src" in */*) here="${src%/*}/.." ;; *) here=".." ;; esac

# The guard hook with no auto run anywhere: present mode, so it prints nothing and no Python starts (docs/SAANI.md, The guard). Builtins
# only, no process. Each home Python could use (HOME; on Windows USERPROFILE too) is looked at by listing folders, never by a failed
# lookup: a folder that lists nothing may be unreadable. Quiet when the home lists files but no .saani, ~/.saani lists files but no
# auto, or ~/.saani/auto lists files but no entry (*.json), no over mark (*.over) and no mark of a `saani auto on` waiting for its
# PostToolUse hook (*.pending), names in any case. Anything else (an empty or unreadable folder, no home) starts Python, which decides
# and fails closed.
quiet() {
  local all=("$1"/*) hit=("$1"/.[s]aani)
  [ "${#all[@]}" -gt 0 ] || return 1
  [ "${#hit[@]}" -gt 0 ] || return 0
  all=("$1"/.saani/*) hit=("$1"/.saani/[a]uto)
  [ "${#all[@]}" -gt 0 ] || return 1
  [ "${#hit[@]}" -gt 0 ] || return 0
  all=("$1"/.saani/auto/*) hit=("$1"/.saani/auto/*.json "$1"/.saani/auto/*.over "$1"/.saani/auto/*.pending)
  [ "${#all[@]}" -gt 0 ] && [ "${#hit[@]}" -eq 0 ]
}
if [ "$#" -eq 1 ] && [ "$1" = guard ]; then
  shopt -s nullglob dotglob nocaseglob
  case "$OSTYPE" in
    msys*|cygwin*) homes=("${HOME//\\//}" "${USERPROFILE//\\//}") ;;     # a Windows Python's home is USERPROFILE
    *) homes=("$HOME") ;;
  esac
  fast=1
  for h in "${homes[@]}"; do
    { [ -n "$h" ] && quiet "$h"; } || fast=0
  done
  if [ "$fast" = 1 ]; then
    # Read the event to its end, so Claude Code's write never meets a closed pipe: -N reads a pipe in blocks (-d '' would read it a byte
    # per system call, about 1 s for a 200 KB Write on Windows).
    while IFS= read -r -N 65536 _; do :; done
    exit 0
  fi
  shopt -u nullglob dotglob nocaseglob
fi

if command -v py >/dev/null 2>&1; then
  exec py -3 -I "$here/saani.py" "$@"
fi
for py in python python3; do
  found="$(command -v "$py" 2>/dev/null)" || continue
  case "$found" in *WindowsApps*) continue ;; esac
  exec "$py" -I "$here/saani.py" "$@"
done
echo "saani: Python 3.11 or newer not found (tried py -3, python, python3)" >&2
exit 1
